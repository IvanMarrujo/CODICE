# ============================================================
# CÓDICE · Environment variables — TEMPLATE
# Copiar a .env (local) y setear los valores reales.
# En Railway (producción) estas mismas variables se configuran
# como Service Variables — NO se leen de este archivo.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=codice
POSTGRES_PASSWORD=changeme
POSTGRES_DB=codice
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://codice:changeme@localhost:5432/codice
# URL del rol de app (permisos limitados) — usar en producción
DATABASE_APP_URL=postgresql://codice_app:changeme@localhost:5432/codice

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_URL=redis://localhost:6379

# ── API ──────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=http://localhost:4000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── APP_SECRET (OBLIGATORIO) ─────────────────────────────────
# ⚠️ REQUERIDO EN RAILWAY AL DESPLEGAR. Si falta, la API hace throw
# en el arranque (apps/api/src/lib/appSecret.ts) y el servicio entra
# en crash-loop → 502 en todas las rutas. Esto causó un outage de
# producción el 2026-08-21 por no estar seteado en Railway.
#
# Deriva la clave AES-256-GCM que cifra credenciales Odoo en reposo y
# firma las actas / firma digital. NO lo regeneres si ya hay
# credenciales Odoo cifradas en ese entorno (quedarían irrecuperables).
# Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=changeme_32_byte_hex
# WEBHOOK_SECRET: nombre legacy; sirve de fallback de APP_SECRET si aún
# no se renombró en algún entorno. También firma el HMAC del sync-agent.
WEBHOOK_SECRET=changeme

# ── Anthropic (IA) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# ── Cloudflare R2 (storage) ──────────────────────────────────
R2_ACCOUNT_ID=changeme
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET_PREFIX=codice
R2_PUBLIC_URL=https://cdn.example.com

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
